# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Server-only administration and rate-limiting configuration
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
KV_REST_API_URL=https://your-kv-provider.example
KV_REST_API_TOKEN=<kv-api-token>

# Playwright credentials belong only in ignored .env.e2e.local.
# See tests/E2E_CREDENTIALS.md.
