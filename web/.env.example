# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Admin (Server-side only)
# WARNING: Never expose this key to the client. Only use in API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Playwright E2E Testing (Optional)
# Create a test account in your Supabase project for automated testing
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your-test-password-here

# Rate Limiting (Vercel KV)
# Created in Vercel Dashboard: Storage → KV
# These are auto-injected by Vercel when you link the KV instance to your project
# In dev without KV, rate limiting is skipped (fail-open). In production, KV is required.
KV_REST_API_URL=https://your-kv-instance.kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-token-here
