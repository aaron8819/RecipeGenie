{
  "name": "recipe-genie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --project=core-ci",
    "test:e2e:core": "playwright test --project=core-ci",
    "test:e2e:core:list": "playwright test --project=core-ci --list",
    "test:e2e:extended": "playwright test --project=extended-chromium",
    "test:e2e:extended:list": "playwright test --project=extended-chromium --list",
    "test:e2e:full": "playwright test --project=chromium --project=firefox --project=webkit --project=\"Mobile Chrome\" --project=\"Mobile Safari\" --project=\"iPhone SE\" --project=iPad",
    "test:e2e:matrix": "playwright test --project=chromium --project=firefox --project=webkit --project=\"Mobile Chrome\" --project=\"Mobile Safari\" --project=\"iPhone SE\" --project=iPad",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:smoke:shopping": "node scripts/run-playwright-shopping-smoke.mjs",
    "test:e2e:smoke:list": "node scripts/check-smoke-tests.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://127.0.0.1:3107",
    "check:no-staged-artifacts": "node scripts/check-no-staged-artifacts.mjs",
    "check:no-new-test-skip": "node scripts/check-no-new-test-skip.mjs",
    "check:no-new-ts-expect-error": "node scripts/check-no-new-ts-expect-error.mjs",
    "check:cycles": "depcruise --config .dependency-cruiser.cjs src",
    "verify": "npm run check:no-staged-artifacts && npm run lint && npm run typecheck && npm run test -- --run && npm run check:no-new-ts-expect-error && npm run check:no-new-test-skip && npm run check:cycles",
    "db:preflight": "node scripts/db-preflight.mjs",
    "db:types:regen:tmp": "npx supabase --workdir .. gen types typescript --local --schema public > src/types/database.generated.tmp.ts",
    "db:types:check": "npm run db:types:regen:tmp && node -e \"const fs=require('fs');const norm=(s)=>s.replace(/\\r\\n/g,'\\n');const expectedPath='src/types/database.generated.ts';const actualPath='src/types/database.generated.tmp.ts';const expected=norm(fs.readFileSync(expectedPath,'utf8'));const actual=norm(fs.readFileSync(actualPath,'utf8'));if(expected!==actual){console.error('Schema/type drift detected between '+expectedPath+' and '+actualPath+'.');process.exitCode=1;}else{console.log('Schema/type drift check passed: generated types match baseline.');}fs.unlinkSync(actualPath);if(process.exitCode)process.exit(process.exitCode);\"",
    "db:types:regen": "npx supabase --workdir .. gen types typescript --local --schema public > src/types/database.generated.ts",
    "db:types:regen:linked": "npx supabase --workdir .. gen types typescript --linked --schema public > src/types/database.generated.ts",
    "db:types:regen:remote": "npx supabase gen types typescript --project-id eyaoahwzixqetjgfghsh --schema public > src/types/database.generated.ts",
    "migrate": "npx tsx scripts/migrate.ts",
    "create-test-account": "npx tsx scripts/create-test-account.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.50.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "^15.5.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "dependency-cruiser": "^17.3.8",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
