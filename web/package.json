{
  "name": "recipe-genie",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:stage2c-compatibility": "node scripts/run-stage2c-compatibility-matrix.mjs",
    "test:e2e:core": "playwright test --project=core-ci",
    "test:e2e:core:list": "playwright test --project=core-ci --list",
    "test:e2e:extended": "playwright test --project=extended-chromium",
    "test:e2e:extended:list": "playwright test --project=extended-chromium --list",
    "test:e2e:matrix": "playwright test --project=chromium --project=firefox --project=webkit --project=\"Mobile Chrome\" --project=\"Mobile Safari\" --project=\"iPhone SE\" --project=iPad",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:smoke:shopping": "node scripts/run-playwright-shopping-smoke.mjs",
    "test:e2e:smoke:list": "node scripts/check-smoke-tests.mjs",
    "test:e2e:ui": "playwright test --ui",
    "local:e2e:bootstrap": "node scripts/local-e2e.mjs bootstrap",
    "local:e2e:reset": "node scripts/local-e2e.mjs reset",
    "local:e2e:status": "node scripts/local-e2e.mjs status",
    "local:e2e:dev": "node scripts/local-e2e-dev.mjs",
    "test:e2e:inspect": "playwright test --project=local-inspection",
    "test:e2e:inspect:headed": "playwright test --project=local-inspection --headed",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://127.0.0.1:3107",
    "check:e2e-secrets": "node scripts/check-e2e-secret-hygiene.mjs",
    "check:no-staged-artifacts": "node scripts/check-no-staged-artifacts.mjs",
    "check:no-new-test-skip": "node scripts/check-no-new-test-skip.mjs",
    "check:no-new-ts-expect-error": "node scripts/check-no-new-ts-expect-error.mjs",
    "check:recipe-uuid-identity": "node scripts/check-recipe-uuid-identity.mjs",
    "check:shopping-contribution-writes": "node scripts/check-shopping-contribution-writes.mjs",
    "check:cycles": "depcruise --config .dependency-cruiser.cjs src",
    "verify": "npm run check:no-staged-artifacts && npm run check:e2e-secrets && npm run lint && npm run typecheck && npm run test -- --run && npm run check:no-new-ts-expect-error && npm run check:no-new-test-skip && npm run check:recipe-uuid-identity && npm run check:shopping-contribution-writes && npm run check:cycles",
    "verify:production": "node scripts/verify-production.mjs",
    "rg:doctor": "node scripts/workflow/doctor.mjs",
    "rg:release:status": "node scripts/workflow/release-status.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "upload:default-recipe-images": "tsx scripts/upload-default-recipe-images.ts",
    "db:preflight": "node scripts/db-preflight.mjs",
    "db:types:regen:tmp": "node scripts/generate-db-types.mjs src/types/database.generated.tmp.ts --local --schema public",
    "db:types:check": "npm run db:types:regen:tmp && node -e \"const fs=require('fs');const norm=(s)=>s.replace(/\\r\\n/g,'\\n');const expectedPath='src/types/database.generated.ts';const actualPath='src/types/database.generated.tmp.ts';const expected=norm(fs.readFileSync(expectedPath,'utf8'));const actual=norm(fs.readFileSync(actualPath,'utf8'));if(expected!==actual){console.error('Schema/type drift detected between '+expectedPath+' and '+actualPath+'.');process.exitCode=1;}else{console.log('Schema/type drift check passed: generated types match baseline.');}fs.unlinkSync(actualPath);if(process.exitCode)process.exit(process.exitCode);\"",
    "db:types:regen": "node scripts/generate-db-types.mjs src/types/database.generated.ts --local --schema public",
    "db:types:regen:linked": "node scripts/generate-db-types.mjs src/types/database.generated.ts --linked --schema public",
    "db:types:regen:remote": "node scripts/generate-db-types.mjs src/types/database.generated.ts --project-id eyaoahwzixqetjgfghsh --schema public"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "^15.5.20",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.20",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.16",
    "postgres": "^3.4.7",
    "supabase": "^2.109.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
